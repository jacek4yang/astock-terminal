{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "趋势智研",
  "version": "5.0.3",
  "identifier": "com.astock.terminal",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "趋势智研 · A股AI研究终端",
        "width": 1600,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"]
      },
      "wix": {
        "language": ["zh-CN"]
      }
    },
    "copyright": "© 2026",
    "category": "Finance",
    "shortDescription": "A股AI量化研究与投资决策终端",
    "longDescription": "Rust确定性量化引擎 + MiniMax智能体的A股散户研究终端。分析结果不构成投资建议。"
  }
}
